<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:macros="sap.fe.macros"
    xmlns:html="http://www.w3.org/1999/xhtml" controllerName="rewe.bc.zbcccmoverview.ext.view.Main">
    <f:DynamicPage id="Main" toggleHeaderOnTitleClick="true" headerExpanded="true">
        <f:title>
            <f:DynamicPageTitle id="MainPageTitle">
                <f:heading>
                    <Title id="MainPageHeading" text="{i18n>MainTitle}" />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader id="MainPageHeader" pinnable="true">
                <FlexBox id="headerContent" alignItems="Start">
                    <VBox id="showChangesBox" class="zbcCcmShowChanges">
                        <Label id="showChangesLabel" text="{i18n>ShowChanges}" labelFor="showChangesSwitch" showColon="true" />
                        <Switch id="showChangesSwitch" state="{view>/showChanges}" />
                    </VBox>
                    <VBox id="filterBarBox">
                        <layoutData>
                            <FlexItemData id="filterBarBoxLayout" growFactor="1" />
                        </layoutData>
                        <macros:FilterBar
                            id="CalcMethodFilterBar"
                            metaPath="@com.sap.vocabularies.UI.v1.SelectionFields#CalcMethod"
                            search=".onSearch"
                        />
                    </VBox>
                </FlexBox>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <VBox id="tileWrapper">
                <FlexBox id="legend" wrap="Wrap" alignItems="Center" class="sapUiSmallMarginBottom">
                    <HBox id="legendA" alignItems="Center" class="zbcCcmLegendItem">
                        <HBox id="legendSwatchA" class="zbcCcmLegendSwatch zbcCcmLevelA" />
                        <Text id="legendTextA" text="{i18n>LegendLevelA}" />
                    </HBox>
                    <HBox id="legendB" alignItems="Center" class="zbcCcmLegendItem">
                        <HBox id="legendSwatchB" class="zbcCcmLegendSwatch zbcCcmLevelB" />
                        <Text id="legendTextB" text="{i18n>LegendLevelB}" />
                    </HBox>
                    <HBox id="legendC" alignItems="Center" class="zbcCcmLegendItem">
                        <HBox id="legendSwatchC" class="zbcCcmLegendSwatch zbcCcmLevelC" />
                        <Text id="legendTextC" text="{i18n>LegendLevelC}" />
                    </HBox>
                    <HBox id="legendD" alignItems="Center" class="zbcCcmLegendItem">
                        <HBox id="legendSwatchD" class="zbcCcmLegendSwatch zbcCcmLevelD" />
                        <Text id="legendTextD" text="{i18n>LegendLevelD}" />
                    </HBox>
                    <HBox id="legendSystem" alignItems="Center" class="zbcCcmLegendItem">
                        <HBox id="legendSwatchSystem" class="zbcCcmLegendSwatch zbcCcmLegendSystem" />
                        <Text id="legendTextSystem" text="{i18n>LegendSystem}" />
                    </HBox>
                </FlexBox>
                <FlexBox
                    id="tileContainer"
                    wrap="Wrap"
                    alignItems="Start"
                    items="{
                        path: '/Dashboard',
                        suspended: true,
                        length: 1000,
                        templateShareable: false
                    }">
                    <items>
                        <f:Card id="tile" semanticRole="ListItem" press=".onTilePress" width="12rem"
                            class="zbcCcmTile sapUiSmallMarginEnd sapUiSmallMarginBottom">
                            <f:content>
                                <VBox id="tileContent" width="100%" class="zbcCcmTileContent">
                                    <FlexBox id="techDebtBox" wrap="Wrap" justifyContent="Center" alignItems="Baseline" class="zbcCcmTechDebt">
                                        <Text id="techDebt" text="{TechnicalDebtScore}" tooltip="{i18n>TechnicalDebtScore}" wrapping="false" class="zbcCcmTechDebtValue" />
                                        <Text id="techDebtChange" text="({ChangeTechnicalDebt})" visible="{view>/showChanges}" wrapping="false" class="zbcCcmChange" />
                                    </FlexBox>
                                    <FlexBox id="levelA" tooltip="{i18n>LegendLevelA}" wrap="Wrap" justifyContent="Center" alignItems="Baseline" class="zbcCcmLevel zbcCcmLevelA">
                                        <Text id="levelAValue" text="{LevelAObjects}" wrapping="false" class="zbcCcmLevelValue" />
                                        <Text id="levelAChange" text="({ChangeLevelA})" visible="{view>/showChanges}" wrapping="false" class="zbcCcmChange" />
                                    </FlexBox>
                                    <FlexBox id="levelB" tooltip="{i18n>LegendLevelB}" wrap="Wrap" justifyContent="Center" alignItems="Baseline" class="zbcCcmLevel zbcCcmLevelB">
                                        <Text id="levelBValue" text="{LevelBObjects}" wrapping="false" class="zbcCcmLevelValue" />
                                        <Text id="levelBChange" text="({ChangeLevelB})" visible="{view>/showChanges}" wrapping="false" class="zbcCcmChange" />
                                    </FlexBox>
                                    <FlexBox id="levelC" tooltip="{i18n>LegendLevelC}" wrap="Wrap" justifyContent="Center" alignItems="Baseline" class="zbcCcmLevel zbcCcmLevelC">
                                        <Text id="levelCValue" text="{LevelCObjects}" wrapping="false" class="zbcCcmLevelValue" />
                                        <Text id="levelCChange" text="({ChangeLevelC})" visible="{view>/showChanges}" wrapping="false" class="zbcCcmChange" />
                                    </FlexBox>
                                    <FlexBox id="levelD" tooltip="{i18n>LegendLevelD}" wrap="Wrap" justifyContent="Center" alignItems="Baseline" class="zbcCcmLevel zbcCcmLevelD">
                                        <Text id="levelDValue" text="{LevelDObjects}" wrapping="false" class="zbcCcmLevelValue" />
                                        <Text id="levelDChange" text="({ChangeLevelD})" visible="{view>/showChanges}" wrapping="false" class="zbcCcmChange" />
                                    </FlexBox>
                                    <VBox id="sidBox" tooltip="{i18n>ProviderTooltip}" alignItems="Center" class="zbcCcmSid">
                                        <Text id="sidText" text="{ProviderID}" textAlign="Center" class="zbcCcmSidText zbcCcmSidTitle" />
                                        <Text id="sidQuota" text="[{CloudReady} | {UpgradeStable}]" textAlign="Center" class="zbcCcmSidText" />
                                    </VBox>
                                </VBox>
                            </f:content>
                        </f:Card>
                    </items>
                </FlexBox>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>