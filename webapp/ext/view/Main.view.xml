<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:macros="sap.fe.macros"
    xmlns:html="http://www.w3.org/1999/xhtml" controllerName="rewe.bc.zbcccmoverview.ext.view.Main">
    <f:DynamicPage id="Main" toggleHeaderOnTitleClick="true" headerExpanded="true">
        <f:title>
            <f:DynamicPageTitle id="MainPageTitle">
                <f:heading>
                    <Title id="MainPageHeading" text="{i18n>MainTitle}" />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader id="MainPageHeader" pinnable="true">
                <macros:FilterBar
                    id="CalcMethodFilterBar"
                    metaPath="@com.sap.vocabularies.UI.v1.SelectionFields#CalcMethod"
                    search=".onSearch"
                />
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <VBox id="tileWrapper" class="zbcCcmContainer">
                <FlexBox
                    id="tileContainer"
                    wrap="Wrap"
                    alignItems="Start"
                    items="{
                        path: '/Dashboard',
                        suspended: true,
                        length: 1000,
                        templateShareable: false
                    }">
                    <items>
                        <f:Card id="tile" semanticRole="ListItem" press=".onTilePress" width="7.5rem"
                            class="zbcCcmTile sapUiSmallMarginEnd sapUiSmallMarginBottom">
                            <f:content>
                                <VBox id="tileContent" width="100%">
                                    <Text id="levelA" text="{LevelAObjects}" textAlign="Center" class="zbcCcmLevel zbcCcmLevelA" />
                                    <Text id="levelB" text="{LevelBObjects}" textAlign="Center" class="zbcCcmLevel zbcCcmLevelB" />
                                    <Text id="levelC" text="{LevelCObjects}" textAlign="Center" class="zbcCcmLevel zbcCcmLevelC" />
                                    <Text id="levelD" text="{LevelDObjects}" textAlign="Center" class="zbcCcmLevel zbcCcmLevelD" />
                                    <VBox id="sidBox" alignItems="Center" class="zbcCcmSid">
                                        <Text id="sidText" text="{ProviderID}" textAlign="Center" class="zbcCcmSidText zbcCcmSidTitle" />
                                        <Text id="sidQuota" text="[{CloudReady} | {UpgradeStable}]" textAlign="Center" class="zbcCcmSidText" />
                                    </VBox>
                                </VBox>
                            </f:content>
                        </f:Card>
                    </items>
                </FlexBox>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>